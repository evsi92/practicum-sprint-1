@startuml
title Warm House Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(TelemetryAndScenariosContext, "Telemetry And Scenarios Context") {
  Container(TelemetryMessageBroker, "Telemetry Message Broker", "Kafka", "Exchanges messages from Partners to Telemetry")
  Container(TelemetryService, "TelemetryService", "Java, Spring", "Handles signals from devices and reacts according to scenarios")
  Container(TelemetryAndScenariosDatabase, "Database", "MySQL", "Stores monitoring information from devices and user's scenarios")
}

Container(TelemetryService, "TelemetryService", "Java, Spring") {
  Component(ScenariosController, "ScenariosController", "Handles requests related to User's Scenarios")
  Component(MonitoringController, "MonitoringController", "Handles requests related to current devices state")
  Component(MessagesListener, "MessagesListener", "Gets messages about changes or actions on devices")

  Component(ServiceLayer, "Service Layer", "Business logic")
  Component(RepositoryLayer, "Repository Layer", "Data access logic")
}

Rel(TelemetryMessageBroker,MessagesListener,"Sends messages about Devices changes")
Rel(MessagesListener,ServiceLayer,"Calls business logic")
Rel(ScenariosController,ServiceLayer,"Calls business logic")
Rel(MonitoringController,ServiceLayer,"Calls business logic")
Rel(ServiceLayer,RepositoryLayer,"Reads/Writes data")
Rel(RepositoryLayer,TelemetryAndScenariosDatabase,"Reads/Writes data")

@enduml
@startuml
title Warm House Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(AccountManagementContext, "Account Management Context") {
  Container(PartnerManagement, "Partner Management System", "Java, Spring", "Managing existing partners and provides ability to create new one")
  Container(AccountManagementDatabase, "Database", "PostgreSQL", "Stores user data, devices and partners information")
}

Container(PartnerManagement, "Partner Management System", "Java, Spring") {
  Component(PartnerController, "PartnerController", "Handles requests related Partner Entity")
  Component(DeviceController, "DeviceController", "Manages variety of devices per Partner")

  Component(ServiceLayer, "Service Layer", "Business logic")
  Component(RepositoryLayer, "Repository Layer", "Data access logic")
}

Rel(PartnerController,ServiceLayer,"Calls business logic")
Rel(DeviceController,ServiceLayer,"Calls business logic")
Rel(ServiceLayer,RepositoryLayer,"Reads/Writes data")
Rel(RepositoryLayer,AccountManagementDatabase,"Reads/Writes data")

@enduml
@startuml
title Warm House Web Application Component Diagram

top to bottom direction

!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Component.puml

Container_Boundary(AccountManagementContext, "Account Management Context") {
  Container(WebApp, "Web Application", "Java, Spring", "Handles user requests (user's registration, device's registration, monitoring)")
  Container(AccountManagementDatabase, "Database", "PostgreSQL", "Stores user data, devices and partners information")
  Container(MessageBroker, "Message Broker", "Kafka", "Exchanges messages between Warn House Systems")
}

Container(WebApp, "Web Application", "Java, Spring") {
  Component(AuthController, "AuthController", "Handles authentication and authorization")
  Component(UserRegistrationController, "UserRegistrationController", "Manages user profiles")
  Component(DeviceRegistrationController, "DeviceRegistrationController", "Manages device registration")
  Component(DeviceManagementController, "DeviceManagementController", "Manages devices")

  Component(TelemetryController, "TelemetryController", "Provides monitoring data")
  Component(UserScenariosController, "UserScenariosController", "Manages user scenarios")

  Component(SsoExternalFeignClient, "SsoExternalFeignClient", "Business logic")

  Component(ServiceLayer, "Service Layer", "Business logic")
  Component(RepositoryLayer, "Repository Layer", "Data access logic")

  Component(TelemetryServiceFeignClient, "TelemetryServiceFeignClient", "Business logic")

  Component(PartnerServiceFeignClient, "PartnerServiceFeignClient", "Business logic")
}

Rel(AuthController,SsoExternalFeignClient,"Calls External API to Authentication")
Rel(UserRegistrationController,ServiceLayer,"Calls business logic")
Rel(DeviceRegistrationController,ServiceLayer,"Calls business logic")
Rel(DeviceManagementController,ServiceLayer,"Calls business logic")


Rel(ServiceLayer,RepositoryLayer,"Reads/Writes data")
Rel(ServiceLayer,MessageBroker,"Produces message")
Rel(ServiceLayer,PartnerServiceFeignClient,"Get Information about Partners and Devices")
Rel(RepositoryLayer,AccountManagementDatabase,"Reads/Writes data")

Rel(TelemetryController,TelemetryServiceFeignClient,"Calls API to get monitoring information")
Rel(UserScenariosController,TelemetryServiceFeignClient,"Calls API to manage scenarios")

@enduml